<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#101010" android:fillViewport="true">
    <LinearLayout android:orientation="vertical" android:gravity="center_horizontal"
        android:padding="24dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="mcrtc" android:textColor="#FFFFFF" android:textSize="42sp"
            android:fontFamily="monospace" android:letterSpacing="0.08" android:layout_marginTop="28dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:text="Peer-to-peer Minecraft multiplayer" android:textColor="#AAAAAA"
            android:textSize="14sp" android:layout_marginTop="4dp" android:layout_marginBottom="28dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <LinearLayout android:orientation="vertical" android:padding="18dp" android:background="#242424"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="PLAY WITH FRIENDS" android:textColor="#55FF55" android:textSize="12sp"
                android:fontFamily="monospace" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Spinner android:id="@+id/mode" android:entries="@array/modes" android:spinnerMode="dialog"
                android:layout_marginTop="8dp" android:background="#3A3A3A" android:padding="10dp"
                android:layout_width="match_parent" android:layout_height="48dp" />
            <EditText android:id="@+id/value" android:hint="Minecraft server address (127.0.0.1:25565)"
                android:textColor="#FFFFFF" android:textColorHint="#888888" android:background="#151515"
                android:padding="12dp" android:layout_marginTop="14dp" android:inputType="textMultiLine"
                android:minLines="3" android:gravity="top|start" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <Button android:id="@+id/paste" android:text="Paste from clipboard" android:textColor="#FFFFFF"
                android:backgroundTint="#3A3A3A" android:layout_marginTop="10dp"
                android:layout_width="match_parent" android:layout_height="48dp" />
            <Button android:id="@+id/start" android:text="Host Server" android:textColor="#101010"
                android:backgroundTint="#55FF55" android:layout_marginTop="12dp"
                android:layout_width="match_parent" android:layout_height="52dp" />
            <Button android:id="@+id/stop" android:text="Disconnect" android:textColor="#FFFFFF"
                android:backgroundTint="#5A2424" android:layout_marginTop="8dp"
                android:layout_width="match_parent" android:layout_height="48dp" />
        </LinearLayout>
        <TextView android:id="@+id/status" android:text="Ready" android:textColor="#55FF55"
            android:fontFamily="monospace" android:textSize="14sp" android:gravity="center"
            android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="Java Edition • direct connection or TURN relay\nNot affiliated with Mojang or Microsoft"
            android:textColor="#777777" android:textSize="11sp" android:gravity="center"
            android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
